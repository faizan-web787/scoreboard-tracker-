<script>
"use strict";

const GAMES = [
  {id:"cricket",name:"Cricket",icon:"🏏",desc:"Runs, wickets & overs"},
  {id:"football",name:"Football",icon:"⚽",desc:"Goals & match timer"},
  {id:"ludo",name:"Ludo",icon:"🎲",desc:"Players & points"},
  {id:"basketball",name:"Basketball",icon:"🏀",desc:"Points & quarters"},
  {id:"badminton",name:"Badminton",icon:"🏸",desc:"Game points"},
  {id:"gaming",name:"Gaming",icon:"🎮",desc:"Custom game scores"}
];
const THEMES = [
  {id:"blue",name:"Ocean Blue",a:"#5b8cff",b:"#9b6dff"},
  {id:"purple",name:"Royal Purple",a:"#a855f7",b:"#ec4899"},
  {id:"red",name:"Fire Red",a:"#ef4444",b:"#f97316"},
  {id:"green",name:"Emerald",a:"#10b981",b:"#84cc16"},
  {id:"orange",name:"Sunset",a:"#f97316",b:"#eab308"},
  {id:"pink",name:"Candy Pink",a:"#ec4899",b:"#8b5cf6"},
  {id:"rainbow",name:"Rainbow",a:"#06b6d4",b:"#f43f5e"}
];
const $ = id => document.getElementById(id);
const safeRead = (key,fallback) => {
  try {const value=JSON.parse(localStorage.getItem(key));return value ?? fallback}
  catch{return fallback}
};
let matches=safeRead("scorezone.matches",[]);
let settings=safeRead("scorezone.settings",{theme:"blue",appearance:"dark"});
let current=null,historyStack=[],elapsed=0,timerInterval=null,timerStart=0;
let toastTimeout=null;

function persist(){
  try{
    localStorage.setItem("scorezone.matches",JSON.stringify(matches));
    localStorage.setItem("scorezone.settings",JSON.stringify(settings));
  }catch{notify("Storage is full. Export or remove old matches.");}
}
function notify(message){
  $("toast").textContent=message;
  $("toast").classList.remove("hidden");
  clearTimeout(toastTimeout);
  toastTimeout=setTimeout(()=>$("toast").classList.add("hidden"),2600);
}
function esc(value){
  return String(value).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}
function gameOf(id){return GAMES.find(g=>g.id===id)||GAMES[5]}
function dateText(date){return new Date(date).toLocaleString([], {dateStyle:"medium",timeStyle:"short"})}

function applySettings(){
  const theme=THEMES.find(t=>t.id===settings.theme)||THEMES[0];
  document.documentElement.style.setProperty("--accent",theme.a);
  document.documentElement.style.setProperty("--accent2",theme.b);
  document.body.classList.toggle("light",settings.appearance==="light");
  $("appearance-select").value=settings.appearance;
  document.querySelectorAll(".theme").forEach(b=>b.classList.toggle("selected",b.dataset.theme===settings.theme));
}
function renderGames(){
  $("game-grid").innerHTML=GAMES.map(g=>`
    <button class="game" data-newgame="${g.id}">
      <div class="game-icon">${g.icon}</div><h3>${g.name}</h3><p>${g.desc}</p>
    </button>`).join("");
  $("game-select").innerHTML=GAMES.map(g=>`<option value="${g.id}">${g.icon} ${g.name}</option>`).join("");
}
function renderThemes(){
  $("theme-list").innerHTML=THEMES.map(t=>`
    <div class="theme-item">
      <button class="theme" data-theme="${t.id}" title="${t.name}"
        aria-label="${t.name}" style="background:linear-gradient(135deg,${t.a},${t.b})"></button>
      <div class="theme-name">${t.name}</div>
    </div>`).join("");
  applySettings();
}
function renderStats(){
  $("stat-total").textContent=matches.length;
  $("stat-finished").textContent=matches.filter(m=>m.status==="finished").length;
  $("stats-total").textContent=matches.filter(m=>m.status==="finished").length;
  $("stats-wins").textContent=matches.filter(m=>m.status==="finished"&&m.s1!==m.s2).length;
  $("stats-draws").textContent=matches.filter(m=>m.status==="finished"&&m.s1===m.s2).length;
}
function matchCard(m){
  const g=gameOf(m.game);
  let result=m.status==="finished"?(m.s1===m.s2?"Draw":m.s1>m.s2?m.t1+" won":m.t2+" won"):"In progress";
  return `<article class="match-card">
    <div><strong>${g.icon} ${esc(m.title||g.name+" match")}</strong>
    <div>${esc(m.t1)} <b>${m.s1}</b> — <b>${m.s2}</b> ${esc(m.t2)}</div>
    <small>${esc(g.name)} · ${dateText(m.updated||m.created)}</small>
    <small style="display:block;margin-top:5px">${esc(result)}</small></div>
    <div class="actions">
      ${m.status!=="finished"?`<button class="btn primary" data-resume="${m.id}">Resume</button>`:""}
      <button class="btn danger" data-delete="${m.id}" aria-label="Delete match">Delete</button>
    </div>
  </article>`;
}
function renderHistory(){
  $("history-count").textContent=matches.length+" matches";
  const html=matches.length?matches.slice().sort((a,b)=>b.updated-a.updated).map(matchCard).join("")
    :'<div class="panel empty">🏆<p>No matches yet.</p><p>Create your first match to see it here.</p><button class="btn primary" data-goto="create">＋ Create match</button></div>';
  $("history-list").innerHTML=html;
  $("recent-list").innerHTML=matches.length?matches.slice().sort((a,b)=>b.updated-a.updated).slice(0,3).map(matchCard).join("")
    :'<div class="panel empty">Your recent matches will appear here.</div>';
}
function renderBreakdown(){
  const rows=GAMES.map(g=>{
    const n=matches.filter(m=>m.game===g.id&&m.status==="finished").length;
    return `<div style="margin:16px 0">
      <div style="display:flex;justify-content:space-between;gap:10px;margin-bottom:8px">${g.icon} ${g.name}<b>${n}</b></div>
      <div style="height:8px;border-radius:10px;background:var(--card);overflow:hidden">
        <div style="height:100%;width:${matches.filter(m=>m.status==="finished").length?100*n/Math.max(1,...GAMES.map(x=>matches.filter(m=>m.game===x.id&&m.status==="finished").length)):0}%;background:linear-gradient(90deg,var(--accent),var(--accent2));border-radius:10px"></div>
      </div></div>`;
  }).join("");
  $("breakdown").innerHTML=rows;
}
function renderAll(){
  renderStats();renderHistory();renderBreakdown();persist();
}
const PAGE_TITLES={
 home:["Dashboard","YOUR GAME CENTER","Every match, all in one place."],
 create:["Create a match","MATCH SETUP","Set up your next game."],
 live:["Live scoreboard","LIVE MATCH","Every point counts."],
 history:["Match history","YOUR MATCHES","Review and manage your games."],
 stats:["Statistics","YOUR PERFORMANCE","Your match activity at a glance."],
 settings:["Settings","MAKE IT YOURS","Personalize your ScoreZone."]
};
function showPage(page){
  ["home","create","live","history","stats","settings"].forEach(p=>$("page-"+p).classList.toggle("hidden",p!==page));
  document.querySelectorAll(".nav").forEach(b=>b.classList.toggle("active",b.dataset.page===page));
  const info=PAGE_TITLES[page];
  $("page-title").textContent=info[0];$("eyebrow").textContent=info[1];$("page-subtitle").textContent=info[2];
  $("quick-create").classList.toggle("hidden",page==="create"||page==="live");
  if(page==="home"||page==="history"||page==="stats")renderAll();
  window.scrollTo({top:0,behavior:"smooth"});
}
function startCreate(game="gaming"){
  $("match-form").reset();
  $("game-select").value=game;
  $("team1-input").value="Team A";$("team2-input").value="Team B";
  showPage("create");
}
function startMatch(e){
  e.preventDefault();
  stopTimer();
  const now=Date.now();
  current={
    id:crypto.randomUUID?crypto.randomUUID():String(now)+Math.random(),
    game:$("game-select").value,
    t1:$("team1-input").value.trim()||"Team A",
    t2:$("team2-input").value.trim()||"Team B",
    title:$("match-title-input").value.trim(),
    s1:0,s2:0,status:"live",created:now,updated:now,elapsed:0
  };
  matches.unshift(current);historyStack=[];elapsed=0;
  renderLive();renderAll();showPage("live");notify("Match started!");
}
function renderLive(){
  if(!current)return;
  const g=gameOf(current.game);
  $("live-game").textContent=g.icon+" "+g.name;
  $("live-date").textContent=dateText(current.created);
  $("live-title").textContent=current.title||g.name+" match";
  $("live-name1").textContent=current.t1;$("live-name2").textContent=current.t2;
  $("live-score1").textContent=current.s1;$("live-score2").textContent=current.s2;
  $("live-status").textContent=current.status==="finished"?"MATCH COMPLETED":
    current.s1===current.s2?"SCORES ARE LEVEL":(current.s1>current.s2?current.t1:current.t2)+" IS LEADING";
  $("timer").textContent=formatTime(elapsed);
}
function formatTime(s){return String(Math.floor(s/60)).padStart(2,"0")+":"+String(s%60).padStart(2,"0")}
function startTimer(){
  if(timerInterval||!current||current.status==="finished")return;
  timerStart=Date.now()-elapsed*1000;
  timerInterval=setInterval(()=>{
    elapsed=Math.floor((Date.now()-timerStart)/1000);
    $("timer").textContent=formatTime(elapsed);
  },500);
  $("timer-toggle").textContent="Ⅱ Pause timer";
}
function stopTimer(){
  if(timerInterval){clearInterval(timerInterval);timerInterval=null;}
  $("timer-toggle").textContent="▶ Start timer";
}
function saveElapsed(){
  if(current){current.elapsed=elapsed;current.updated=Date.now();persist();}
}
function changeScore(team,points){
  if(!current||current.status==="finished"){notify("Start a new match to score.");return}
  const key=team===1?"s1":"s2";
  const next=Math.max(0,current[key]+points);
  if(next===current[key]){notify("Score cannot go below zero.");return}
  historyStack.push({team,key,old:current[key]});
  current[key]=next;current.updated=Date.now();
  renderLive();renderAll();
}
function undoScore(){
  if(!current||!historyStack.length){notify("No score action to undo.");return}
  const action=historyStack.pop();current[action.key]=action.old;
  current.updated=Date.now();renderLive();renderAll();notify("Last score undone.");
}
function finishMatch(){
  if(!current||current.status==="finished")return;
  if(!confirm("Finish this match and save the final result?"))return;
  stopTimer();saveElapsed();current.status="finished";current.updated=Date.now();
  renderLive();renderAll();notify("Final result saved.");
}
function abandonMatch(){
  if(!current)return;
  if(!confirm("End this match? It will be removed from match history."))return;
  stopTimer();matches=matches.filter(m=>m.id!==current.id);
  current=null;historyStack=[];elapsed=0;renderAll();showPage("home");
}
function resumeMatch(id){
  const m=matches.find(x=>x.id===id);
  if(!m)return;
  if(m.status==="finished"){notify("This match is already completed.");return}
  stopTimer();current=m;elapsed=m.elapsed||0;historyStack=[];
  renderLive();showPage("live");
}
function deleteMatch(id){
  if(!confirm("Delete this match from history?"))return;
  matches=matches.filter(m=>m.id!==id);
  if(current&&current.id===id){stopTimer();current=null;historyStack=[];}
  renderAll();notify("Match deleted.");
}
document.addEventListener("click",e=>{
  const target=e.target.closest("button");
  if(!target)return;
  if(target.dataset.page)showPage(target.dataset.page);
  if(target.dataset.goto)showPage(target.dataset.goto);
  if(target.dataset.newgame)startCreate(target.dataset.newgame);
  if(target.dataset.theme){settings.theme=target.dataset.theme;applySettings();persist();}
  if(target.dataset.score!==undefined)changeScore(target.dataset.team==="2"?2:1,Number(target.dataset.score));
  if(target.dataset.resume)resumeMatch(target.dataset.resume);
  if(target.dataset.delete)deleteMatch(target.dataset.delete);
});
$("quick-create").addEventListener("click",()=>startCreate());
$("match-form").addEventListener("submit",startMatch);
$("undo-btn").addEventListener("click",undoScore);
$("finish-btn").addEventListener("click",finishMatch);
$("abandon-btn").addEventListener("click",abandonMatch);
$("timer-toggle").addEventListener("click",()=>{
  if(timerInterval){stopTimer();saveElapsed()}else startTimer();
});
$("timer-reset").addEventListener("click",()=>{
  stopTimer();elapsed=0;saveElapsed();$("timer").textContent="00:00";notify("Timer reset.");
});
$("appearance-select").addEventListener("change",e=>{
  settings.appearance=e.target.value;applySettings();persist();
});
$("clear-history").addEventListener("click",()=>{
  if(!confirm("Permanently delete all locally saved matches? This cannot be undone."))return;
  stopTimer();matches=[];current=null;historyStack=[];elapsed=0;renderAll();showPage("home");notify("Match history cleared.");
});
window.addEventListener("beforeunload",saveElapsed);

renderGames();renderThemes();renderAll();showPage("home");
</script>
